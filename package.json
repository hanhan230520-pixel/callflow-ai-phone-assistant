{
  "name": "callflow-ai-phone-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CallFlow — a local-first AI phone appointment workbench with explicit mock integrations.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node scripts/ui-smoke.mjs",
    "preview": "vite preview",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.52.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  }
}
