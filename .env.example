# CallFlow local demo configuration
# Copy to .env only if you need local overrides. Never commit real credentials.
PORT=8788
HOST=127.0.0.1
DATABASE_PATH=./data/callflow-full.db
BACKUP_DIR=./backups
DEMO_MODE=true

# Demo account passwords (change before any non-local usage).
DEMO_ADMIN_PASSWORD=CallFlowDemo!2026
DEMO_MANAGER_PASSWORD=CallFlowManager!2026
DEMO_AGENT_PASSWORD=CallFlowAgent!2026
DEMO_VIEWER_PASSWORD=CallFlowViewer!2026

# External integrations remain simulated unless explicitly implemented.
AI_MODE=mock
STT_PROVIDER=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
ALLOW_PRIVATE_WEBHOOKS=false
